// Materialized only in the isolated Actions deployment checkout, never in convex/ at rest.
import { internalMutation, internalQuery } from './_generated/server';
import { v } from 'convex/values';
import schema from './schema';
import { resolveAuthRedirectUrl } from './auth';

const name = 'stampaix-pwa-phase3-e2e';
function guard(secret: string) {
  if (process.env.PHASE3_PREVIEW_NAME !== name || process.env.PHASE3_FIXTURE_SECRET !== secret ||
      !secret || process.env.PHASE3_PREVIEW_URL !== process.env.CONVEX_CLOUD_URL ||
      process.env.CONVEX_SITE_URL !== process.env.PHASE3_PREVIEW_URL?.replace('.cloud', '.site') ||
      /utmost-fennec-280|aware-llama-850/.test(process.env.PHASE3_PREVIEW_URL ?? ''))
    throw new Error('PREVIEW_FIXTURES_DISABLED');
}
export const empty = internalQuery({
  args: { secret: v.string() }, returns: v.boolean(),
  handler: async (ctx, args) => {
    guard(args.secret);
    for (const table of Object.keys(schema.tables)) {
      if (await ctx.db.query(table as any).first()) return false;
    }
    return true;
  },
});
// Bounded atomic reset. Never deployed to ordinary backend; requires prior owned Preview markers.
export const reset = internalMutation({
  args: { secret: v.string() }, returns: v.object({ syntheticOnly: v.boolean(), deleted: v.number() }),
  handler: async (ctx, args) => {
    guard(args.secret);
    const all = new Map<string, any[]>();
    let total = 0;
    for (const table of Object.keys(schema.tables)) {
      const rows = await ctx.db.query(table as any).take(201);
      if (rows.length > 200 || (total += rows.length) > 4000) throw new Error('SYNTHETIC_RESET_LIMIT');
      all.set(table, rows);
    }
    const users = all.get('users') ?? [];
    const allowedEmails = new Set(['phase3-owner@example.invalid', 'phase3-staff@example.invalid', 'phase3-customer@example.invalid', 'phase3-manager@example.invalid', 'phase3-deletion@example.invalid']);
    if (!users.length || users.some(user => !allowedEmails.has(user.email))) throw new Error('RESET_NON_SYNTHETIC_ACTOR');
    const actors = new Set(users.map(user => user._id));
    const businesses = all.get('businesses') ?? [];
    if (businesses.some(business => !['phase3-primary', 'phase3-secondary'].includes(business.externalId) || !actors.has(business.ownerUserId))) throw new Error('RESET_NON_SYNTHETIC_BUSINESS');
    const scopes = new Set(businesses.map(business => business._id));
    // A normal account-deletion test leaves a team acceptance audit record.
    // Prove its deleted actor from the existing accepted synthetic invitation;
    // never allow an unknown actor merely because it belongs to this business.
    const deletedStaffInvites = new Map<string, any>();
    const deletedStaffEvents = new Set<string>();
    for (const invite of all.get('staffInvites') ?? []) {
      const business = businesses.find(row => row._id === invite.businessId);
      if (invite.invitedEmail !== 'phase3-deletion@example.invalid' ||
          invite.status !== 'accepted' || invite.targetRole !== 'staff' ||
          !business || invite.invitedByUserId !== business.ownerUserId ||
          !invite.acceptedByUserId || actors.has(invite.acceptedByUserId) ||
          invite.invitedUserId !== invite.acceptedByUserId ||
          typeof invite.acceptedAt !== 'number') continue;
      for (const event of all.get('staffEvents') ?? []) {
        if (event.targetInviteId === invite._id && event.businessId === invite.businessId &&
            event.eventType === 'invite_accepted' && event.toRole === 'staff' &&
            event.toStatus === 'active' && event.createdAt === invite.acceptedAt &&
            event.actorUserId === invite.acceptedByUserId &&
            event.targetUserId === invite.acceptedByUserId) {
          deletedStaffInvites.set(invite._id, invite);
          deletedStaffEvents.add(event._id);
        }
      }
    }
    for (const [table, rows] of all) for (const row of rows) {
      if (row.businessId !== undefined && !scopes.has(row.businessId)) throw new Error('RESET_UNKNOWN_BUSINESS_SCOPE');
      for (const key of ['userId', 'actorId', 'customerId', 'customerUserId', 'actorUserId', 'ownerUserId', 'recipientUserId', 'referrerUserId', 'referredUserId', 'toUserId', 'targetUserId', 'invitedUserId', 'acceptedByUserId', 'invitedByUserId']) {
        if (row[key] === undefined || actors.has(row[key])) continue;
        const provenDeletedInvite = table === 'staffInvites' &&
          ['invitedUserId', 'acceptedByUserId'].includes(key) && deletedStaffInvites.has(row._id);
        const provenDeletedEvent = table === 'staffEvents' &&
          ['actorUserId', 'targetUserId'].includes(key) && deletedStaffEvents.has(row._id);
        if (!provenDeletedInvite && !provenDeletedEvent) throw new Error('RESET_UNKNOWN_ACTOR_SCOPE');
      }
    }
    for (const rows of all.values()) for (const row of rows) await ctx.db.delete(row._id);
    return { syntheticOnly: true, deleted: total };
  },
});
const fixtureValidator = v.object({
  businessId: v.id('businesses'), secondBusinessId: v.id('businesses'),
  programId: v.id('loyaltyPrograms'), membershipId: v.id('memberships'),
  rewardId: v.id('referralRewards'), staffEntryId: v.id('businessStaff'),
});
export const seed = internalMutation({
  args: { secret: v.string(), owner: v.id('users'), staff: v.id('users'), customer: v.id('users'), manager: v.id('users') },
  returns: fixtureValidator,
  handler: async (ctx, args) => {
    guard(args.secret);
    if (new Set([args.owner, args.staff, args.customer, args.manager]).size !== 4 ||
        await ctx.db.query('businesses').first()) throw new Error('FIXTURES_REQUIRE_EMPTY_PREVIEW');
    const manager = await ctx.db.get(args.manager);
    if (manager?.email !== 'phase3-manager@example.invalid' || !manager.isActive) throw new Error('SYNTHETIC_MANAGER_REQUIRED');
    const now = Date.now();
    for (const [role, id] of [['owner', args.owner], ['staff', args.staff], ['customer', args.customer]] as const) {
      const user = await ctx.db.get(id);
      if (!user || user.email !== `phase3-${role}@example.invalid` || !user.isActive)
        throw new Error('SYNTHETIC_ACTOR_REQUIRED');
      await ctx.db.patch(id, { fullName: `Synthetic ${role}`, role: role === 'owner' ? 'merchant' : role,
        activeMode: role === 'customer' ? 'customer' : 'business', customerOnboardedAt: now,
        businessOnboardedAt: role === 'owner' ? now : undefined, updatedAt: now });
    }
    const createBusiness = async (label: string) => {
      const id = await ctx.db.insert('businesses', { ownerUserId: args.owner, externalId: `phase3-${label}`,
        name: `Synthetic Phase 3 ${label}`, businessPublicId: `phase3-${label}`, joinCode: label === 'primary' ? 'P3ABCD' : 'P3EFGH', isActive: true, subscriptionPlan: 'premium',
        subscriptionStatus: 'active', subscriptionStartAt: now, subscriptionEndAt: now + 86400000,
        billingPeriod: null, createdAt: now, updatedAt: now });
      await ctx.db.insert('businessStaff', { businessId: id, userId: args.owner, staffRole: 'owner', status: 'active', isActive: true, createdAt: now, updatedAt: now });
      await ctx.db.insert('businessBillingAccounts', { businessId: id, ownerUserId: args.owner,
        providerAppUserId: `phase3-synthetic-${label}`, plan: 'premium', lastPlan: 'premium',
        status: 'active', hasProviderEvidence: true, currentPeriodEndAt: now + 86400000,
        createdAt: now, updatedAt: now });
      return id;
    };
    const businessId = await createBusiness('primary');
    const secondBusinessId = await createBusiness('secondary');
    await ctx.db.patch(args.owner, { activeBusinessId: businessId });
    await ctx.db.patch(args.staff, { activeBusinessId: businessId });
    const staffEntryId = await ctx.db.insert('businessStaff', { businessId, userId: args.staff,
      staffRole: 'staff', status: 'active', isActive: true, createdAt: now, updatedAt: now });
    const programId = await ctx.db.insert('loyaltyPrograms', { businessId, title: 'Synthetic Test Card',
      rewardName: 'Synthetic Reward', maxStamps: 3, stampIcon: '☕', isActive: true,
      isArchived: false, status: 'active', allowPosEnroll: true, createdAt: now, updatedAt: now });
    const membershipId = await ctx.db.insert('memberships', { userId: args.customer, businessId, programId,
      currentStamps: 0, isActive: true, createdAt: now, updatedAt: now });
    const referralLinkId = await ctx.db.insert('customerReferralLinks', { businessId, code: 'phase3-synthetic',
      referrerUserId: args.customer, originProgramId: programId, membershipId, shareSurface: 'card_screen',
      status: 'active', expiresAt: now + 86400000, openCount: 0, createdAt: now, updatedAt: now });
    const qualificationEventId = await ctx.db.insert('events', { type: 'PHASE3_SYNTHETIC_QUALIFICATION',
      businessId, programId, membershipId, customerUserId: args.customer, createdAt: now });
    const customerReferralId = await ctx.db.insert('customerReferrals', { businessId, referralLinkId,
      referrerUserId: args.customer, referredUserId: args.owner, originProgramId: programId,
      originMembershipId: membershipId, joinedMembershipIds: [membershipId], status: 'completed',
      rewardGrantStatus: 'granted', qualificationEventId, rewardDefinitionSnapshot: { configVersion: 1,
        rewardType: 'BENEFIT', rewardValue: 1, benefitTitle: 'Synthetic Benefit', rewardRecipients: 'referrer',
        monthlyLimit: 'unlimited', originProgramId: programId, originMembershipId: membershipId, createdAt: now },
      createdAt: now, updatedAt: now });
    const rewardId = await ctx.db.insert('referralRewards', { customerReferralId, businessId,
      recipientUserId: args.customer, recipientRole: 'referrer', configuredRewardType: 'BENEFIT',
      actualRewardType: 'BENEFIT', rewardValue: 1, benefitTitle: 'Synthetic Benefit',
      targetProgramId: programId, targetMembershipId: membershipId, status: 'granted',
      qualificationEventId, expiresAt: now + 86400000, createdAt: now, updatedAt: now });
    await ctx.db.patch(args.manager, { fullName: 'Synthetic manager', role: 'merchant', activeMode: 'business', customerOnboardedAt: now, businessOnboardedAt: now, activeBusinessId: businessId, updatedAt: now });
    await ctx.db.insert('businessStaff', { businessId, userId: args.manager, staffRole: 'manager', status: 'active', isActive: true, createdAt: now, updatedAt: now });
    return { businessId, secondBusinessId, programId, membershipId, rewardId, staffEntryId };
  },
});
export const arrange = internalMutation({
  args: { secret: v.string(), fixtures: fixtureValidator, stamps: v.number(),
    eventlessReward: v.optional(v.boolean()), staffActive: v.optional(v.boolean()), programActive: v.optional(v.boolean()) }, returns: v.null(),
  handler: async (ctx, args) => {
    guard(args.secret);
    const business = await ctx.db.get(args.fixtures.businessId);
    if (business?.externalId !== 'phase3-primary' || args.stamps < 0 || args.stamps > 3)
      throw new Error('SYNTHETIC_SCOPE_REQUIRED');
    const membership = await ctx.db.get(args.fixtures.membershipId);
    const program = await ctx.db.get(args.fixtures.programId);
    const staff = await ctx.db.get(args.fixtures.staffEntryId);
    if (!membership || membership.businessId !== business._id || membership.programId !== program?._id ||
        program.businessId !== business._id || staff?.businessId !== business._id)
      throw new Error('SYNTHETIC_SCOPE_REQUIRED');
    await ctx.db.patch(membership._id, { currentStamps: args.stamps, lastStampAt: undefined, updatedAt: Date.now() });
    if (args.staffActive !== undefined) await ctx.db.patch(staff._id, {
      isActive: args.staffActive, status: args.staffActive ? 'active' : 'suspended', updatedAt: Date.now() });
    if (args.programActive !== undefined) await ctx.db.patch(program._id, {
      isActive: args.programActive, updatedAt: Date.now() });
    if (args.eventlessReward) {
      const { _id, _creationTime, ...definition } = program;
      const inactiveId = await ctx.db.insert('loyaltyPrograms', { ...definition, title: 'Synthetic inactive referral target', isActive: false, isArchived: true, status: 'archived' });
      await ctx.db.patch(args.fixtures.rewardId, { targetProgramId: inactiveId, status: 'granted', redeemedAt: undefined, redeemedByUserId: undefined, redeemedEventId: undefined });
    }
    return null;
  },
});
export const evidence = internalQuery({
  args: { secret: v.string(), fixtures: fixtureValidator, runtimeId: v.string() },
  returns: v.object({ events: v.number(), sessions: v.number(), stamps: v.number(), rewardStatus: v.string() }),
  handler: async (ctx, args) => {
    guard(args.secret);
    const events = await ctx.db.query('events').withIndex('by_scannerRuntimeSessionId_createdAt',
      q => q.eq('scannerRuntimeSessionId', args.runtimeId)).take(20);
    const sessions = await ctx.db.query('scanSessions').withIndex('by_scannerRuntimeSessionId',
      q => q.eq('scannerRuntimeSessionId', args.runtimeId)).take(20);
    const member = await ctx.db.get(args.fixtures.membershipId);
    const reward = await ctx.db.get(args.fixtures.rewardId);
    return { events: events.length, sessions: sessions.length, stamps: member?.currentStamps ?? -1,
      rewardStatus: reward?.status ?? 'missing' };
  },
});

// QA arrangement is internal and exists only in the private Preview staging bundle.
export const qaArrange = internalMutation({
  args: { secret: v.string(), fixtures: fixtureValidator, kind: v.union(v.literal('restore'), v.literal('onboarding'), v.literal('reward'), v.literal('joined'), v.literal('marker'), v.literal('referral')), },
  returns: v.null(),
  handler: async (ctx, args) => {
    guard(args.secret);
    const business = await ctx.db.get(args.fixtures.businessId);
    const membership = await ctx.db.get(args.fixtures.membershipId);
    if (business?.externalId !== 'phase3-primary' || membership?.businessId !== business._id) throw new Error('SYNTHETIC_SCOPE_REQUIRED');
    const customer = await ctx.db.get(membership.userId);
    if (customer?.email !== 'phase3-customer@example.invalid') throw new Error('SYNTHETIC_ACTOR_REQUIRED');
    await ctx.db.patch(args.fixtures.staffEntryId, { isActive: true, status: 'active' });
    await ctx.db.patch(args.fixtures.programId, { isActive: true, isArchived: false, status: 'active' });
    await ctx.db.patch(membership._id, { currentStamps: args.kind === 'reward' ? 3 : 0, lastStampAt: undefined, isActive: true });
    if (args.kind === 'referral') {
      const reward = await ctx.db.get(args.fixtures.rewardId);
      if (reward?.recipientUserId !== customer._id || reward.businessId !== business._id) throw new Error('SYNTHETIC_REWARD_REQUIRED');
      await ctx.db.patch(reward._id, { targetProgramId: args.fixtures.programId, targetMembershipId: membership._id, status: 'granted', redeemedAt: undefined, redeemedByUserId: undefined, redeemedEventId: undefined, expiresAt: Date.now() + 86400000 });
    }
    await ctx.db.patch(business._id, { shortDescription: 'Synthetic Preview only', businessPhone: '0000000000', serviceTypes: ['food_drink'], serviceTags: ['synthetic'], location: { lat: 32.7005, lng: 35.1005 } });
    await ctx.db.patch(business._id, { name: args.kind === 'marker' ? '<strong data-rc-marker>synthetic</strong>' : 'Synthetic Phase 3 primary' });
    const secondaryPrograms = await ctx.db.query('loyaltyPrograms').withIndex('by_businessId', q => q.eq('businessId', args.fixtures.secondBusinessId)).take(1);
    if (!secondaryPrograms.length) await ctx.db.insert('loyaltyPrograms', { businessId: args.fixtures.secondBusinessId, title: 'Synthetic Secondary Card', rewardName: 'Synthetic Secondary Reward', maxStamps: 3, stampIcon: 'coffee', isActive: true, isArchived: false, status: 'active', createdAt: Date.now(), updatedAt: Date.now() });
    if (args.kind === 'onboarding') await ctx.db.patch(customer._id, { fullName: undefined, firstName: undefined, lastName: undefined, customerOnboardedAt: undefined, activeMode: 'customer' });
    if (args.kind === 'joined') await ctx.db.patch(customer._id, { customerOnboardedAt: Date.now(), fullName: 'Synthetic customer', activeMode: 'customer' });
    return null;
  },
});

export const authPolicy = internalQuery({
  args: { secret: v.string(), origin: v.string() },
  returns: v.object({ previewCallback: v.boolean(), foreignRejected: v.boolean(), pathRejected: v.boolean(), credentialsRejected: v.boolean(), fragmentRejected: v.boolean() }),
  handler: async (_ctx, args) => {
    guard(args.secret);
    if (!/^https:\/\/stampaix-business--[a-z0-9]+\.expo\.app$/.test(args.origin)) throw new Error('PREVIEW_ORIGIN_REQUIRED');
    const denied = (url: string) => { try { resolveAuthRedirectUrl(url); return false; } catch { return true; } };
    return { previewCallback: resolveAuthRedirectUrl(`${args.origin}/oauth-callback`) === `${args.origin}/oauth-callback`, foreignRejected: denied('https://example.invalid/oauth-callback'), pathRejected: denied(`${args.origin}/wallet`), credentialsRejected: denied(args.origin.replace('https://', 'https://synthetic@') + '/oauth-callback'), fragmentRejected: denied(`${args.origin}/oauth-callback#synthetic`) };
  },
});

export const qaCelebrationEvidence = internalQuery({
  args: { secret: v.string(), fixtures: fixtureValidator },
  returns: v.object({ available: v.number(), claimed: v.number(), presented: v.number(), revoked: v.number(), expired: v.number(), newestStatus: v.string() }),
  handler: async (ctx, args) => {
    guard(args.secret);
    const membership = await ctx.db.get(args.fixtures.membershipId);
    const customer = membership ? await ctx.db.get(membership.userId) : null;
    if (customer?.email !== 'phase3-customer@example.invalid' || membership?.businessId !== args.fixtures.businessId) throw new Error('SYNTHETIC_SCOPE_REQUIRED');
    const rows = await ctx.db.query('redemptionCelebrationReceipts').withIndex('by_ownerUserId', q => q.eq('ownerUserId', customer._id)).order('desc').take(30);
    return { available: rows.filter(r => r.status === 'available').length, claimed: rows.filter(r => r.status === 'claimed').length, presented: rows.filter(r => r.status === 'presented').length, revoked: rows.filter(r => r.status === 'revoked').length, expired: rows.filter(r => r.status === 'expired').length, newestStatus: rows[0]?.status ?? 'none' };
  },
});

// Leave usable data after destructive cloud QA, instead of handing testers its final fault state.
export const manualRestore = internalMutation({
  args: { secret: v.string(), fixtures: fixtureValidator },
  returns: v.object({ syntheticOnly: v.boolean(), actors: v.number(), stamps: v.number(), readyReward: v.boolean(), inboxMessages: v.number() }),
  handler: async (ctx, args) => {
    guard(args.secret);
    if (process.env.STAMPAIX_ENV !== 'preview' || process.env.MANUAL_QA_ENABLED !== 'true' || process.env.MANUAL_QA_DEPLOYMENT_TYPE !== 'preview') throw new Error('MANUAL_QA_DISABLED');
    const business = await ctx.db.get(args.fixtures.businessId);
    const member = await ctx.db.get(args.fixtures.membershipId);
    if (business?.externalId !== 'phase3-primary' || member?.businessId !== business._id) throw new Error('SYNTHETIC_SCOPE_REQUIRED');
    const now = Date.now();
    const actors = [];
    for (const role of ['customer', 'owner', 'manager', 'staff'] as const) {
      const rows = await ctx.db.query('users').withIndex('by_email', q => q.eq('email', `phase3-${role}@example.invalid`)).take(2);
      if (rows.length !== 1 || !rows[0].isActive) throw new Error('SYNTHETIC_ACTOR_REQUIRED');
      const actor = rows[0];
      if ((role === 'owner' && actor._id !== business.ownerUserId) || (role === 'customer' && actor._id !== member.userId)) throw new Error('SYNTHETIC_SCOPE_REQUIRED');
      await ctx.db.patch(actor._id, { fullName: `Synthetic ${role}`, firstName: 'Synthetic', lastName: role,
        customerOnboardedAt: now, businessOnboardedAt: ['owner', 'manager'].includes(role) ? now : undefined,
        activeMode: role === 'customer' ? 'customer' : 'business', activeBusinessId: role === 'customer' ? undefined : business._id,
        marketingOptIn: true, marketingOptInAt: now, updatedAt: now });
      actors.push(actor);
    }
    await ctx.db.patch(business._id, { name: 'Synthetic Phase 3 primary', isActive: true,
      shortDescription: 'סביבת בדיקה סינתטית בלבד', businessPhone: '0000000000', serviceTypes: ['food_drink'], serviceTags: ['synthetic'],
      location: { lat: 32.7005, lng: 35.1005 }, subscriptionEndAt: now + 30 * 86400000, updatedAt: now });
    await ctx.db.patch(args.fixtures.programId, { isActive: true, isArchived: false, status: 'active', updatedAt: now });
    await ctx.db.patch(args.fixtures.staffEntryId, { isActive: true, status: 'active', updatedAt: now });
    await ctx.db.patch(member._id, { currentStamps: 2, isActive: true, lastStampAt: undefined, updatedAt: now });
    await ctx.db.patch(args.fixtures.rewardId, { status: 'granted', targetProgramId: args.fixtures.programId,
      targetMembershipId: member._id, redeemedAt: undefined, redeemedByUserId: undefined, redeemedEventId: undefined,
      expiresAt: now + 30 * 86400000, updatedAt: now });
    const programs = await ctx.db.query('loyaltyPrograms').withIndex('by_businessId', q => q.eq('businessId', business._id)).take(50);
    let rewardProgram = programs.find(row => row.title === 'Synthetic Ready Reward');
    if (!rewardProgram) {
      const id = await ctx.db.insert('loyaltyPrograms', { businessId: business._id, title: 'Synthetic Ready Reward',
        rewardName: 'הטבת בדיקה מוכנה למימוש', maxStamps: 3, stampIcon: 'coffee', isActive: true, isArchived: false,
        status: 'active', createdAt: now, updatedAt: now });
      rewardProgram = (await ctx.db.get(id))!;
    }
    const memberships = await ctx.db.query('memberships').withIndex('by_userId', q => q.eq('userId', member.userId)).take(50);
    const rewardMembership = memberships.find(row => row.programId === rewardProgram!._id);
    if (rewardMembership) await ctx.db.patch(rewardMembership._id, { currentStamps: 3, isActive: true, lastStampAt: undefined, updatedAt: now });
    else await ctx.db.insert('memberships', { userId: member.userId, businessId: business._id, programId: rewardProgram._id,
      currentStamps: 3, isActive: true, createdAt: now, updatedAt: now });
    const campaigns = await ctx.db.query('campaigns').withIndex('by_businessId', q => q.eq('businessId', business._id)).take(50);
    let campaign = campaigns.find(row => row.title === 'Synthetic Manual QA Campaign');
    if (!campaign) {
      const id = await ctx.db.insert('campaigns', { businessId: business._id, programId: args.fixtures.programId,
        type: 'general_promo', title: 'Synthetic Manual QA Campaign', messageTitle: 'ברוכים הבאים לבדיקות StampAix',
        messageBody: 'הודעה סינתטית לבדיקת תיבת ההודעות והקמפיינים.', status: 'active', activationStatus: 'active',
        family: 'promo', source: 'manual', channels: ['in_app'], automationEnabled: false, isActive: true,
        createdAt: now, updatedAt: now });
      campaign = (await ctx.db.get(id))!;
    }
    for (const actor of actors) {
      const existing = await ctx.db.query('messageLog').withIndex('by_campaignId_toUserId', q => q.eq('campaignId', campaign!._id).eq('toUserId', actor._id)).take(1);
      if (!existing.length) await ctx.db.insert('messageLog', { businessId: business._id, campaignId: campaign._id,
        toUserId: actor._id, channel: 'in_app', status: 'sent',
        inboxPayload: { title: 'ברוכים הבאים לבדיקות StampAix', body: 'הודעת בדיקה סינתטית — אפשר לסמן כנקראה.' }, createdAt: now });
    }
    return { syntheticOnly: true, actors: actors.length, stamps: 2, readyReward: true, inboxMessages: actors.length };
  },
});
