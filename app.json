{
  "expo": {
    "name": "StampAix",
    "slug": "stampix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/StampAix_LOGO_S.png",
    "scheme": "stampaix",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/StampAix_LOGO_S.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFDFD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stampaix.app",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "associatedDomains": [
        "applinks:stampaix.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "StampAix uses the camera to scan customer and business QR codes.",
        "NSLocationWhenInUseUsageDescription": "StampAix uses your location to show nearby participating businesses.",
        "NSPhotoLibraryUsageDescription": "StampAix lets businesses choose images for loyalty cards and programs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/StampAix_LOGO_S.png",
        "backgroundColor": "#FDFDFD"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.stampaix.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "stampaix.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#FDFDFD",
      "barStyle": "dark-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/StampAix_LOGO_S.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "StampAix uses the camera to scan customer and business QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StampAix uses your location to show nearby participating businesses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StampAix lets businesses choose images for loyalty cards and programs."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6BFF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "forcesRTL": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74e10cc1-aece-4da6-8049-e62cc8adf17d"
      }
    },
    "owner": "petfamily2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/74e10cc1-aece-4da6-8049-e62cc8adf17d"
    }
  }
}
